# Scriptis — variáveis de ambiente (exemplo)
# Copie para .env.local e preencha os valores.

# Origem pública do site (obrigatório para links mágicos de autenticação)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=

# Supabase (opcional — histórico por usuário e autenticação)
# Projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (opcional — geração com Claude, API paga)
# Console → Settings → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022